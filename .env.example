# Copie para .env.local e ajuste. No servidor (Docker), passe a variável no build da imagem:
# o Next grava o valor no código durante o build, então mudá-la só no contêiner não tem efeito.
# Endereço da Can Games API (repositório can-api), terminando em /api.
NEXT_PUBLIC_API_URL=http://localhost:4000/api
